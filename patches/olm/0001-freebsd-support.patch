+// DNSRecords returns a snapshot of the resource aliases currently known to
+// olm's DNS proxy. It is used by embedders (os-pangolin) to publish alias
+// records to an external resolver such as OPNsense Unbound. An empty slice is
+// returned before the first connect or after teardown.
+func (o *Olm) DNSRecords() []dns.SnapshotRecord {
+	if o.dnsProxy == nil {
+		return nil
+	}
+	return o.dnsProxy.SnapshotRecords()
+}
+
+// DNSProxyIP returns the address of olm's internal DNS proxy inside the
+// utility subnet, or an empty string before the first connect. OPNsense uses
+// it as the conditional-forwarding target when that optional feature is
+// enabled.
+func (o *Olm) DNSProxyIP() string {
+	if o.dnsProxy == nil {
+		return ""
+	}
+	return o.dnsProxy.GetProxyIP().String()
+}
