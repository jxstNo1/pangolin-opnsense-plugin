+// SnapshotRecord is one A/AAAA record currently held by the local record
+// store. It is used by the os-pangolin agent to publish the aliases that
+// Unbound should synchronise; the store remains the source of truth while the
+// tunnel is running.
+type SnapshotRecord struct {
+	Domain string `json:"domain"`
+	IP     string `json:"ip"`
+	Type   string `json:"type"`
+	SiteID int    `json:"siteId"`
+}
+
+// Snapshot returns a copy of every A and AAAA record in the store, including
+// wildcard patterns. Records are returned in a stable order (exact domains
+// first, then wildcards; within a domain A before AAAA) so callers can diff
+// successive snapshots without spurious changes.
+func (s *DNSRecordStore) Snapshot() []SnapshotRecord {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	var out []SnapshotRecord
+	appendSet := func(domain string, rs *recordSet) {
+		for _, ip := range rs.A {
+			out = append(out, SnapshotRecord{
+				Domain: strings.TrimSuffix(domain, "."),
+				IP:     ip.String(),
+				Type:   "A",
+				SiteID: rs.SiteId,
+			})
+		}
+		for _, ip := range rs.AAAA {
+			out = append(out, SnapshotRecord{
+				Domain: strings.TrimSuffix(domain, "."),
+				IP:     ip.String(),
+				Type:   "AAAA",
+				SiteID: rs.SiteId,
+			})
+		}
+	}
+
+	domains := make([]string, 0, len(s.exact))
+	for domain := range s.exact {
+		domains = append(domains, domain)
+	}
+	sort.Strings(domains)
+	for _, domain := range domains {
+		appendSet(domain, s.exact[domain])
+	}
+
+	wildcards := make([]string, 0, len(s.wildcards))
+	for domain := range s.wildcards {
+		wildcards = append(wildcards, domain)
+	}
+	sort.Strings(wildcards)
+	for _, domain := range wildcards {
+		appendSet(domain, s.wildcards[domain])
+	}
+	return out
+}
